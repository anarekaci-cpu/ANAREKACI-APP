# ───────── ANAREKA-CI — variables d'environnement ─────────
# Copiez ce fichier en `.env.local` (jamais committé) et adaptez.

# Clé de signature des sessions (32 caractères minimum). OBLIGATOIRE en production.
#   openssl rand -base64 48
# En développement, si elle est absente, une clé aléatoire est créée dans .data/session.key
SESSION_SECRET=

# Compte administrateur créé au tout premier lancement (quand .data/db.json n'existe pas encore).
# En développement : téléphone 0100000000 / mot de passe « Anareka@2026 » par défaut.
# En production sans ADMIN_PASSWORD : un mot de passe aléatoire est affiché une fois dans les logs.
ADMIN_TELEPHONE=0100000000
ADMIN_PASSWORD=

# Dossier de la base locale (défaut : ./.data). En production, pointez vers un volume persistant.
# DATA_DIR=/var/lib/anareka

# Paiement en ligne CinetPay (optionnel — désactivé tant que ces 3 valeurs sont vides)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
